rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function groupOf(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && request.auth.uid in groupOf(groupId).memberUids;
    }

    function isGroupOwner(groupId) {
      return isSignedIn() && groupOf(groupId).ownerUid == request.auth.uid;
    }

    // username -> uid lookup, used at signup to check availability and for admin password resets
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isMe(uid) || (resource.data.groupId != null && isGroupMember(resource.data.groupId));
      allow create: if isMe(uid);
      allow update: if isMe(uid);
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // membership changes (join/leave) go through arrayUnion/arrayRemove on memberUids only
      allow update: if isGroupMember(groupId) || isSignedIn();
      allow delete: if isGroupOwner(groupId);
    }

    match /documents/{docId} {
      allow read, update, delete: if isMe(resource.data.ownerUid) || (resource.data.groupId != null && isGroupMember(resource.data.groupId));
      allow create: if isMe(request.resource.data.ownerUid);
    }

    match /packingBags/{bagId} {
      allow read, update, delete: if isMe(resource.data.ownerUid);
      allow create: if isMe(request.resource.data.ownerUid);
    }

    match /outfitItems/{itemId} {
      allow read, update, delete: if isMe(resource.data.ownerUid);
      allow create: if isMe(request.resource.data.ownerUid);
    }

    match /suppliesItems/{itemId} {
      allow read, update, delete: if isMe(resource.data.ownerUid) ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(resource.data.ownerUid)) &&
         get(/databases/$(database)/documents/users/$(resource.data.ownerUid)).data.groupId != null &&
         isGroupMember(get(/databases/$(database)/documents/users/$(resource.data.ownerUid)).data.groupId));
      allow create: if isMe(request.resource.data.ownerUid);
    }

    match /itineraryItems/{itemId} {
      allow read, update: if (resource.data.groupId == null && isMe(resource.data.createdBy)) || (resource.data.groupId != null && isGroupMember(resource.data.groupId));
      allow create: if isSignedIn();
      allow delete: if isMe(resource.data.createdBy) || (resource.data.groupId != null && isGroupOwner(resource.data.groupId));
    }

    match /accommodationOptions/{optId} {
      allow read, update: if isGroupMember(resource.data.groupId);
      allow create: if isSignedIn() && isGroupMember(request.resource.data.groupId);
      allow delete: if isGroupOwner(resource.data.groupId);
    }

    match /expenses/{expId} {
      allow read, update, delete: if (resource.data.groupId == null && isMe(resource.data.paidBy)) || (resource.data.groupId != null && isGroupMember(resource.data.groupId));
      allow create: if isSignedIn();
    }

    // Spots are curated by the trip owner via /admin; everyone signed in can read & favorite them.
    match /spots/{spotId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // tighten to an admin check once you add one
    }

    match /favorites/{favId} {
      allow read, write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /spotSubmissions/{subId} {
      allow read, update: if isGroupMember(resource.data.groupId);
      allow create: if isSignedIn() && isGroupMember(request.resource.data.groupId);
    }

    match /activityLog/{entryId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isSignedIn() && isGroupMember(request.resource.data.groupId);
      allow update, delete: if false;
    }

    match /announcements/{annId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isSignedIn() && isGroupMember(request.resource.data.groupId);
    }
  }
}
