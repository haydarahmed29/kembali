rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Each user uploads documents (tickets, etc.) into their own folder.
    // Reading a file is open to anyone signed in with the download URL (Firebase Storage
    // download URLs are already unguessable tokens); tighten this if you need stricter sharing.
    match /documents/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
  }
}
